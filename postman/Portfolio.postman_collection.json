{
  "info": {
    "name": "COMP229 Portfolio Assignment 2",
    "description": "Set owner credentials and base URL first. User update and delete require the token of the target user; sign in as the disposable user for those requests. DELETE /users is allowed only in explicitly enabled non-production lab mode. Bulk delete requests are destructive; run only against disposable data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ownerEmail",
      "value": ""
    },
    {
      "key": "ownerPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signin",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Signed in', () => pm.response.to.have.status(200)); if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create contacts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
