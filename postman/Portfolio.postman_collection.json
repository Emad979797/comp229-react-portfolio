          "mode": "raw",
          "raw": "{\n  \"firstname\": \"API\",\n  \"lastname\": \"Demo\",\n  \"email\": \"demo@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201)); if(pm.response.code === 201) pm.collectionVariables.set('contactsId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
